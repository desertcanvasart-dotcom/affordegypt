# Template only — every value here is a PLACEHOLDER.
# Never paste a real credential into this file: it is committed to git.
# Real values belong in .env (gitignored) or the Railway dashboard.

# --- Required ---
# Railway-injected when you attach a Postgres plugin
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Public URL of the deployed app (no trailing slash). Used in transactional emails.
APP_URL=https://your-app.up.railway.app

# Random long string used to sign JWTs. Generate with: openssl rand -hex 64
JWT_SECRET=replace-me-with-a-long-random-string

# Express session secret. Generate with: openssl rand -hex 64
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Recommended ---
NODE_ENV=production
# Railway sets PORT automatically; only set locally.
# PORT=5000

# Set to "false" only if your Postgres does NOT require SSL (rare on Railway).
# PGSSL=false

# --- Analytics (OPTIONAL OVERRIDES) ---
# The live property IDs are defaults in client/src/lib/analytics.ts, so tracking
# works without setting anything here. GA4/Ads IDs are public identifiers, not
# secrets — they ship in the page source either way.
# Set these only to point a build at a DIFFERENT property (e.g. staging).
# VITE_* are inlined by Vite at build time, so they must be set in the BUILD
# environment; setting them only at runtime has no effect.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX

# --- Integrations (optional, features degrade gracefully if missing) ---
# Resend (transactional email). Get a key at https://resend.com/api-keys.
# Domain affordegypt.com must be verified there with the published DNS records.
RESEND_API_KEY=
# From address must use the verified Resend domain.
FROM_EMAIL=hello@affordegypt.com

# Stripe is being retired in favour of Tab.travel — see package.json _notes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLIC_KEY=

OPENAI_API_KEY=
